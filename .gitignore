# Dependencies
/node_modules
# npm is the package manager here; a second lockfile only drifts
bun.lock
bun.lockb
pnpm-lock.yaml
yarn.lock
/.pnp
.pnp.js

# Testing
/coverage

# Next.js build output
/.next/
/out/

# Production build standalone files
/build/
/dist/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dev.log
server.log
*.log

# Local SQLite Database
/db/*.db
/db/*.db-journal
*.db
*.db-journal

# Environment Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# OS files
.DS_Store
Thumbs.db

# Agent Context & Tool Results (Unused/Temporary)
/agent-ctx/
/tool-results/
/worklog.md

# Generated Downloads
/download/*
!/download/README.md

# TypeScript incremental build cache
*.tsbuildinfo

# Runtime user uploads — served from the database, not from git
/public/uploads/*
!/public/uploads/.gitkeep

# Test coverage output
/coverage

# Local database dumps — never commit
/backups/

# Never run `next build` while `next dev` is live — they share this
# directory's manifests, and a build overwrite corrupts the running dev
# server's route table (see: NextAuth 404s, 2026-08-25). Verify build
# correctness in a separate worktree/checkout instead.
